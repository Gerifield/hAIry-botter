# ---------------------------------------------------------
# 1. Core Identity (Mutually Exclusive)
# Options: "agent" (default orchestrator) OR "mcp_cli" (stateless worker)
# ---------------------------------------------------------
run_mode: "agent"

# ---------------------------------------------------------
# 2. Agent Mode Options
# (These are ONLY evaluated if run_mode is "agent" except the name and desc.)
# ---------------------------------------------------------
agent_config:
  enable_chat_proxy: true   # The main HTTP UI/Proxy interface
  cors_allowed_origin: "*"
  cors_allowed_methods: "POST, OPTIONS"
  cors_allowed_headers: "Content-Type, X-User-ID"
  http_port: ":8080"
  enable_mcp_http: false    # Stateful MCP server running on a port
  mcp_port: ":8081"
  agent_name: "hairy-botter-agent"
  agent_description: "A Senior Go Developer AI Agent."

# ---------------------------------------------------------
# 3. Universal Settings (Evaluated by all modes)
# ---------------------------------------------------------
model: "gemini-flash-latest"
gemini_search_disabled: true # Gemini specific config
log_level: warning


# Defines the specific role and behavioral constraints
personality:
  role: "Senior Go Developer"
  system_prompt: "You are an autonomous coding agent. Always verify the TODO.md before writing code."

# Capabilities toggles to allow subagents to be fully lobotomized/stateless
capabilities:
  rag:
    enabled: true
    directory: "./knowledge_base"
    embedding_model: "gemini-embedding-001"
  history_summary:
    enabled: true
    message_count: 20
  mcp_servers:
    - type: http
      path: http://localhost:8081/mcp
    - type: cli
      path: "go"
      args:
        - "run"
        - "cmd/server-mcp-skills/main.go"
      env:
        MY_VAR: "value"


# ---------------------------------------------------------
# 4. Context Management
# ---------------------------------------------------------
context:
  # Files re-read from disk and injected into the system prompt on every request.
  # Leave empty (`[]`) for stateless sub-agents to save context space.
  static_inject:
    - "TODO.md"           # The active task state
    - "hairy-botter.md"   # Static repository rules and architecture map
    - "memory.md"         # Long-term crystallized facts

  # Shell commands executed on every request; output is appended to the system prompt.
  # Useful for injecting dynamic data like the current time, git status, etc.
  #
  # Two execution modes:
  #   - command only: runs via `sh -c <command>` — supports pipes, redirects, shell syntax
  #   - command + args: runs directly (safer, handles spaces in arguments correctly)
  dynamic_data:
    - name: "Current date"
      command: "date"
    # - name: "Git status"
    #   command: "git status --short"
    # - name: "Weather"
    #   command: "weather-bin"
    #   args: ["--city", "New York"]

# ---------------------------------------------------------
# API Keys (Fallback config, can be overridden by env vars)
# ---------------------------------------------------------
# api_keys:
#   gemini: "your_gemini_api_key_here"
